# MONGODB_URI: Connection string for your MongoDB database on your VPS.
# Example: mongodb://127.0.0.1:27017/spoorthy_dss or mongodb://user:pass@127.0.0.1:27017/spoorthy_dss
MONGODB_URI="mongodb://127.0.0.1:27017/spoorthy_dss"

# GEMINI_API_KEY: Optional. If omitted, the system automatically uses
# 100% on-device programmatic & Tesseract OCR parsing with zero API keys.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted on your domain or VPS IP.
APP_URL="http://localhost:3000"


